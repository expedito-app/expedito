# Copie para .env.test.local (ignorado pelo Git) para rodar os scripts de teste.
# As contas são criadas automaticamente pelos scripts na primeira execução,
# exceto TEST_MANAGER_UI (npm run manager:create) e TEST_FIELD_UI (tela Equipe).
# Use uma senha forte e exclusiva de teste.
TEST_PASSWORD=
TEST_MANAGER_A=gestor.a@expedito.test
TEST_MANAGER_B=gestor.b@expedito.test
TEST_FIELD_A=campo.a@expedito.test
TEST_MANAGER_UI=gestor.ui@expedito.test
TEST_FIELD_UI=campo.ui@expedito.test

# Senha das contas da demo (npm run seed:demo): Ana Ribeiro, Bruno Santos e
# Carla Mendes (@expedito.test). Criadas pelo seed na primeira execução.
DEMO_PASSWORD=
