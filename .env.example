# Copie para .env.local e preencha com os valores do projeto Supabase
# (Project Settings → API). Nunca versione o .env.local.

# Públicas (vão para o navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# IA (somente servidor). Chave criada no Google AI Studio.
GEMINI_API_KEY=
# Opcional: padrão gemini-3.5-flash
GEMINI_MODEL=
